# Copy to .env and fill in values.
# On sci.kku.ac.th use APP_BASE_PATH=/app/SCiGENIE and Google URIs for that host.

APP_BASE_PATH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_JS_ORIGIN=http://localhost:8081
GOOGLE_REDIRECT_URI=http://localhost:8081/auth/google/callback.php

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_WEBHOOK_URL=

FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=scigenie-kku-fb-2026

OPENAI_API_KEY=
# OpenAI-compatible endpoint, e.g.
# https://api.openai.com/v1
# https://openrouter.ai/api/v1
# https://api.groq.com/openai/v1
OPENAI_BASE_URL=
OPENAI_MODEL=claude-haiku-4.5
OPENAI_EMBEDDING_MODEL=local-hash-v2
# If your gateway supports OpenAI /embeddings, set e.g. text-embedding-3-small instead.
# gen.ai.kku.ac.th currently has chat models only (no /embeddings endpoint).
SEMANTIC_MIN_SIM=0.45
SEMANTIC_BONUS_SCALE=45

SCIGENIE_DB_HOST=10.104.177.79
SCIGENIE_DB_PORT=3306
SCIGENIE_DB_NAME=scigeniedb
SCIGENIE_DB_USER=devsc
SCIGENIE_DB_PASS=

EOFFICE_DB_HOST=10.104.177.79
EOFFICE_DB_PORT=3306
EOFFICE_DB_NAME=eoffice
EOFFICE_DB_USER=devsc
EOFFICE_DB_PASS=
